# App
APP_ENV=local
HTTP_ADDR=:18080
PUBLIC_API_BASE_URL=http://localhost:18080
PUBLIC_WS_BASE_URL=ws://localhost:18080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=live_auction
POSTGRES_USER=live_auction
POSTGRES_PASSWORD=live_auction
DATABASE_URL=postgres://live_auction:live_auction@localhost:5432/live_auction?sslmode=disable

# Redis
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
# Required for the Redis/Kafka hot-engine profile and PTS-1B.
KAFKA_BROKERS=localhost:9092
KAFKA_BID_TOPIC=auction.bid-events
KAFKA_DLQ_TOPIC=auction.dlq

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=liveauction
MINIO_ROOT_PASSWORD=liveauction123
S3_BUCKET=live-auction-items
S3_REGION=local
S3_USE_SSL=false

# AI relay / atmosphere assistant
# auto: uses the configured API_KEY when set, otherwise deterministic local templates.
AI_PROVIDER_MODE=auto
AI_RELAY_BASE_URL=https://api.gptgod.online/v1
AI_RELAY_MODEL=gemini-3.1-flash-image-preview
AI_RELAY_TIMEOUT=45s
AI_RELAY_MAX_TOKENS=2048
AI_COMMENTARY_BATCH_SIZE=4
AI_COMMENTARY_TASK_TIMEOUT=20s
AI_COMMENTARY_BACKFILL_LOOKBACK=24h

# Session/auth
SESSION_TTL=12h
MOCK_HOST_USER_ID=host_1
MOCK_USER_ID=user_1
# Keep false for normal local runtime; tests use APP_ENV=test, and debugging can opt in explicitly.
ALLOW_MOCK_AUTH=false

# Admission protection
# This file is the conservative local demo profile, not the PTS-1B profile.
# For PTS-1B use .env.pts1b.example or tests/pts/reset-l4b-final-second-pressure.sh.
ADMISSION_ENABLED=true
BID_USER_LIMIT_PER_SECOND=3
BID_IP_LIMIT_PER_SECOND=10
BID_AUCTION_LIMIT_PER_SECOND=80
BID_AUCTION_MAX_IN_FLIGHT=32
# Conservative local demo default: PostgreSQL lane remains easier to inspect manually.
# Current PTS-1B hot path must use BID_ENGINE_MODE=redis_ledger with Kafka.
BID_ENGINE_MODE=postgres_lane
BID_ENGINE_KAFKA_APPEND_TIMEOUT=750ms
BID_LANE_WORKERS=1
BID_LANE_QUEUE_SIZE=128
BID_LANE_QUEUE_TIMEOUT=750ms
BID_REDIS_GUARD_MAX_STALENESS=1500ms
BID_REDIS_GUARD_TIMEOUT=30ms

# Realtime/WebSocket protection
WS_TICKET_MAX_IN_FLIGHT=256
WS_CONNECT_MAX_IN_FLIGHT=512
WS_RETRY_AFTER=1s
WS_QUEUE_MESSAGES=256
WS_QUEUE_BYTES=1048576
WS_RECOVERY_MAX_EVENTS=300
WS_SNAPSHOT_REBUILD_MAX_IN_FLIGHT=4
WS_HEARTBEAT_INTERVAL=20s
WS_HEARTBEAT_TIMEOUT=5s
LEADERBOARD_PROJECTION_QUEUE_SIZE=1024
LEADERBOARD_PROJECTION_WORKERS=1
REALTIME_HISTORY_TTL=30m
REALTIME_SNAPSHOT_TTL=30m
REALTIME_STREAM_EPOCH_TTL=24h
API_KEY=replace-with-api-key
