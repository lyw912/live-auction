          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="flag admission contamination" enabled="true">
            <stringProp name="cacheKey">live-auction-flag-admission</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
// v3 post-processor: assert DECIDED response contract.
// In the v3 single-writer decision log architecture, every bid must return
// a synchronous final decision (decision_status=DECIDED) with HTTP 200.
// HTTP 202 is tolerated only for exceptional relay-backpressure cases (near-zero ratio).
if (prev.getResponseCode() == '429') {
  prev.setSuccessful(false)
  prev.setResponseMessage('ADMISSION_CONTAMINATION_HTTP_429')
  return
}
if (!(prev.getResponseCode() == '200' || prev.getResponseCode() == '202')) {
  prev.setSuccessful(false)
  prev.setResponseMessage('UNEXPECTED_BID_HTTP_' + prev.getResponseCode())
  return
}
def body = prev.getResponseDataAsString()
if (body != null && body.length() > 0) {
  try {
    def json = new groovy.json.JsonSlurper().parseText(body)
    def code = (json.code ?: json.result ?: '').toString()
    if (code == 'RATE_LIMITED' || code == 'BID_AUCTION_TOO_HOT') {
      prev.setSuccessful(false)
      prev.setResponseMessage('ADMISSION_CONTAMINATION_' + code)
      return
    }
    // v3 contract check: response must be a final decision (DECIDED), not pending.
    def decisionStatus = (json.decision_status ?: '').toString()
    def durabilityStatus = (json.durability_status ?: '').toString()
    if (prev.getResponseCode() == '200') {
      if (decisionStatus != 'DECIDED') {
        prev.setSuccessful(false)
        prev.setResponseMessage('V3_VIOLATION_NOT_DECIDED_decision_status=' + decisionStatus)
        return
      }
      // durability_status must be ENGINE_DURABLE: proves the decision reached the Kafka
      // WAL before the response was sent. Any other value means the gateway returned a
      // decision that has not been durably committed — a correctness violation.
      if (durabilityStatus != 'ENGINE_DURABLE') {
        prev.setSuccessful(false)
        prev.setResponseMessage('V3_VIOLATION_DURABILITY_durability_status=' + durabilityStatus)
        return
      }
      // engine_seq must be present and positive for every DECIDED response (accepted and
      // rejected alike). A missing or zero seq means the engine did not assign a position
      // in the decision log — the response cannot be trusted or verified post-run.
      def rawSeq = json.engine_seq
      def engineSeqLong = (rawSeq instanceof Number) ? rawSeq.toLong() : -1L
      if (engineSeqLong <= 0L) {
        prev.setSuccessful(false)
        prev.setResponseMessage('V3_VIOLATION_ENGINE_SEQ_MISSING_OR_ZERO_engine_seq=' + rawSeq)
        return
      }
      // Track v3 result distribution for post-run analysis.
      def result = (json.result ?: '').toString()
      vars.put('bid_result', result)
      vars.put('bid_engine_seq', engineSeqLong.toString())
      vars.put('bid_durability', durabilityStatus)
    }
    if (prev.getResponseCode() == '202') {
      // 202 is allowed only for PROCESSING_RETRY_LATER (relay backpressure edge).
      // Flag it for analysis but don't fail the sample — the verifier counts these.
      vars.put('bid_result', 'PROCESSING_RETRY_LATER_202')
      prev.setResponseMessage('V3_RELAY_PENDING_202')
    }
  } catch (Throwable ignored) {
  }
}
            ]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="hold VU after one-shot bid without report sampler" enabled="true">
            <stringProp name="cacheKey">live-auction-hold-after-one-shot-bid-postprocessor-v1</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
long holdUntilMS = Long.parseLong(props.getProperty('hold_until_ms', '60000'))
def startedAt = props.get('l4b_plan_started_at_ms') as java.util.concurrent.atomic.AtomicLong
if (startedAt == null) {
  startedAt = new java.util.concurrent.atomic.AtomicLong(System.currentTimeMillis())
  def existing = props.putIfAbsent('l4b_plan_started_at_ms', startedAt)
  if (existing != null) {
    startedAt = existing as java.util.concurrent.atomic.AtomicLong
  }
}
long sleepMS = startedAt.get() + holdUntilMS - System.currentTimeMillis()
if (sleepMS > 0L) {
  Thread.sleep(sleepMS)
}
            ]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
