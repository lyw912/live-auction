<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="live-auction cloud core pressure" enabled="true">
      <stringProp name="TestPlan.comments">Downstream-pressure JMeter plan for Alibaba Cloud PTS. Requires ALLOW_MOCK_AUTH=false and ADMISSION_ENABLED=false.</stringProp>
