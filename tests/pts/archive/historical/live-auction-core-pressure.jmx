      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="10 bid hot-row and outbox pressure" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(bid_threads,600)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(bid_ramp_sec,120)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(bid_duration_sec,300)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(bid_delay_sec,0)}</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="bid pacing" enabled="true">
          <stringProp name="ConstantTimer.delay">${__P(bid_think_ms,0)}</stringProp>
        </ConstantTimer>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="compute monotonic valid bid" enabled="true">
          <stringProp name="cacheKey">live-auction-compute-bid</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
long now = System.currentTimeMillis()
long base = Long.parseLong(props.get('base_price_cents') ?: '10000')
long inc = Long.parseLong(props.get('increment_cents') ?: '5000')
long threadNo = ctx.getThreadNum() + 1L
long localCount = Long.parseLong(vars.get('bid_local_count') ?: '0') + 1L
vars.put('bid_local_count', Long.toString(localCount))
long amount = base + inc * (2L + threadNo + localCount)
String clientBidId = 'pts-bid-' + threadNo + '-' + localCount + '-' + now
vars.put('amount_cents', Long.toString(amount))
vars.put('client_bid_id', clientBidId)
vars.put('idempotency_key', clientBidId)
vars.put('client_seen_seq', '0')
          ]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST bid downstream pressure" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"client_bid_id":"${client_bid_id}","amount_cents":${amount_cents},"client_seen_seq":0}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">/api/auctions/${__P(auction_id,auc_live)}/bids</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="bid idempotency header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Key</stringProp>
                <stringProp name="Header.value">${client_bid_id}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="bid HTTP 200 only" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Bid returned non-200. In downstream-pressure this usually means auth, admission, or backend failure.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="flag admission contamination" enabled="true">
            <stringProp name="cacheKey">live-auction-flag-admission</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
if (prev.getResponseCode() == '429') {
  prev.setSuccessful(false)
  prev.setResponseMessage('ADMISSION_CONTAMINATION_HTTP_429')
  return
}
def body = prev.getResponseDataAsString()
if (body != null && body.length() > 0) {
  try {
    def json = new groovy.json.JsonSlurper().parseText(body)
    def code = (json.code ?: json.result ?: '').toString()
    if (code == 'RATE_LIMITED' || code == 'BID_AUCTION_TOO_HOT') {
      prev.setSuccessful(false)
      prev.setResponseMessage('ADMISSION_CONTAMINATION_' + code)
    }
  } catch (Throwable ignored) {
  }
}
            ]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="20 snapshot recovery read pressure" enabled="true">
