        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST L2-P4 steady bid" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">l2p4-steady-bid-http-v2</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

long now = System.currentTimeMillis()
def startRef = props.get('l2p4_bid_start_ms') as java.util.concurrent.atomic.AtomicLong
if (startRef == null) {
  long delay = Long.parseLong(props.getProperty('bid_start_delay_ms', '90000'))
  startRef = new java.util.concurrent.atomic.AtomicLong(now + delay)
  def existing = props.putIfAbsent('l2p4_bid_start_ms', startRef)
  if (existing != null) startRef = existing as java.util.concurrent.atomic.AtomicLong
}
long start = startRef.get()
if (now < start) Thread.sleep(start - now)
long elapsedMs = System.currentTimeMillis() - start
long elapsedSec = elapsedMs > 0L ? Math.floorDiv(elapsedMs, 1000L) : 0L
long totalRate
if (elapsedSec < 120L) {
  totalRate = Long.parseLong(props.getProperty('bid_rate_stage1_per_sec', '20'))
} else if (elapsedSec < 240L) {
  totalRate = Long.parseLong(props.getProperty('bid_rate_stage2_per_sec', '60'))
} else {
  totalRate = Long.parseLong(props.getProperty('bid_rate_stage3_per_sec', '100'))
}
long pressureIPs = Long.parseLong(props.getProperty('pressure_ips', '6'))
if (pressureIPs < 1L) pressureIPs = 1L
long localRate = Math.round(totalRate / (double) pressureIPs)
if (localRate < 1L) localRate = 1L
long intervalMs = Math.round(1000.0d / (double) localRate)
if (intervalMs < 1L) intervalMs = 1L
def nextRef = props.get('l2p4_next_bid_slot_ms') as java.util.concurrent.atomic.AtomicLong
if (nextRef == null) {
  nextRef = new java.util.concurrent.atomic.AtomicLong(System.currentTimeMillis())
  def existing = props.putIfAbsent('l2p4_next_bid_slot_ms', nextRef)
  if (existing != null) nextRef = existing as java.util.concurrent.atomic.AtomicLong
}
long slot = nextRef.getAndAdd(intervalMs)
long waitMs = slot - System.currentTimeMillis()
if (waitMs > 0L) Thread.sleep(waitMs)
String userID = vars.get('bid_user_id') ?: 'unknown'
def counter = props.get('l2p4_bid_counter') as java.util.concurrent.atomic.AtomicLong
if (counter == null) {
  counter = new java.util.concurrent.atomic.AtomicLong(0L)
  def existing = props.putIfAbsent('l2p4_bid_counter', counter)
  if (existing != null) counter = existing as java.util.concurrent.atomic.AtomicLong
}
long seq = counter.incrementAndGet()
long base = Long.parseLong(props.getProperty('contention_amount_base_cents', '10000'))
long inc = Long.parseLong(props.getProperty('contention_amount_increment_cents', '5000'))
long stride = Long.parseLong(props.getProperty('contention_amount_stride', '1000'))
long amount = base + inc * stride * seq
String id = 'pts-2p4-' + userID + '-' + seq
String body = groovy.json.JsonOutput.toJson([
  client_bid_id: id,
  amount_cents: amount,
  client_seen_seq: (seq > 1L ? seq - 1L : 0L)
])
String protocol = props.getProperty('protocol', 'http')
String host = props.getProperty('host', '172.16.179.112')
String port = props.getProperty('port', '18080')
String url = protocol + '://' + host + ':' + port + '/api/auctions/auc_live/bids'
def client = props.get('l2p4_bid_http_client') as HttpClient
if (client == null) {
  client = HttpClient.newHttpClient()
  def existing = props.putIfAbsent('l2p4_bid_http_client', client)
  if (existing != null) client = existing as HttpClient
}
def req = HttpRequest.newBuilder(URI.create(url))
  .header('Content-Type', 'application/json')
  .header('Accept', 'application/json')
  .header('Authorization', 'Bearer ' + (vars.get('bid_token') ?: ''))
  .header('Idempotency-Key', id)
  .POST(HttpRequest.BodyPublishers.ofString(body))
  .build()
long sampleStart = System.currentTimeMillis()
def res = client.send(req, HttpResponse.BodyHandlers.ofString())
SampleResult.setResponseCode(Integer.toString(res.statusCode()))
SampleResult.setResponseData(res.body(), 'UTF-8')
if (!(res.statusCode() == 200 || res.statusCode() == 202)) {
  SampleResult.setSuccessful(false)
  String msg = 'UNEXPECTED_BID_HTTP_' + res.statusCode()
  try {
    def err = new groovy.json.JsonSlurper().parseText(res.body())
    msg += '_' + ((err.code ?: '') as String) + '_' + ((err.message ?: '') as String).replaceAll('[^A-Za-z0-9_.-]+', '_')
  } catch (Throwable ignored) {}
  SampleResult.setResponseMessage(msg.take(500))
  return
}
if (res.statusCode() == 200) {
  def json = new groovy.json.JsonSlurper().parseText(res.body())
  if ((json.decision_status ?: '').toString() != 'DECIDED') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('NOT_DECIDED')
    return
  }
  if ((json.durability_status ?: '').toString() != 'ENGINE_DURABLE') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('NOT_ENGINE_DURABLE')
    return
  }
}
SampleResult.setSuccessful(true)
SampleResult.setResponseMessage('BID_DECIDED_DURABLE_' + id)
          ]]></stringProp>
        </JSR223Sampler>
