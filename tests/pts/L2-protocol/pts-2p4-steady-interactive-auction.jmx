<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="L2-P4 steady interactive auction" enabled="true">
      <stringProp name="TestPlan.comments">L2-P4: production-realistic steady realtime auction. 2400 long-lived WebSocket viewers join first, 360 active bidder sessions generate paced sustained bid arrivals after the room is connected, and 240 readers poll snapshot/leaderboard/my-bids with pacing. Bid pacing is open-model per pressure IP: total offered arrival curve 20/s -> 60/s -> 100/s over the bid window, divided by pressure_ips. WS fanout sampler observes through the bid window, fetches final auction seq, verifies every connected viewer saw seq 1..final_seq, and reports worst published_at_ms-to-client-receive latency as PTS-visible fanout RT.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
