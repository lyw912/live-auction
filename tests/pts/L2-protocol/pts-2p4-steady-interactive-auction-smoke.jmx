        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST L2-P4 smoke bid" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">l2p4-smoke-bid-http-v1</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

String userID = vars.get('bid_user_id') ?: 'unknown'
def counter = props.get('l2p4_bid_counter') as java.util.concurrent.atomic.AtomicLong
if (counter == null) {
  counter = new java.util.concurrent.atomic.AtomicLong(0L)
  def existing = props.putIfAbsent('l2p4_bid_counter', counter)
  if (existing != null) counter = existing as java.util.concurrent.atomic.AtomicLong
}
long seq = counter.incrementAndGet()
long base = Long.parseLong(props.getProperty('contention_amount_base_cents', '10000'))
long inc = Long.parseLong(props.getProperty('contention_amount_increment_cents', '5000'))
long stride = Long.parseLong(props.getProperty('contention_amount_stride', '1000'))
long amount = base + inc * stride * seq
String id = 'pts-2p4-smoke-' + userID + '-' + seq
String body = groovy.json.JsonOutput.toJson([
  client_bid_id: id,
  amount_cents: amount,
  client_seen_seq: (seq > 1L ? seq - 1L : 0L)
])
String protocol = props.getProperty('protocol', 'http')
String host = props.getProperty('host', '172.16.179.112')
String port = props.getProperty('port', '18080')
String url = protocol + '://' + host + ':' + port + '/api/auctions/auc_live/bids'
def client = props.get('l2p4_bid_http_client') as HttpClient
if (client == null) {
  client = HttpClient.newHttpClient()
  def existing = props.putIfAbsent('l2p4_bid_http_client', client)
  if (existing != null) client = existing as HttpClient
}
def req = HttpRequest.newBuilder(URI.create(url))
  .header('Content-Type', 'application/json')
  .header('Accept', 'application/json')
  .header('Authorization', 'Bearer ' + (vars.get('bid_token') ?: ''))
  .header('Idempotency-Key', id)
  .POST(HttpRequest.BodyPublishers.ofString(body))
  .build()
long sampleStart = System.currentTimeMillis()
def res = client.send(req, HttpResponse.BodyHandlers.ofString())
SampleResult.setResponseCode(Integer.toString(res.statusCode()))
SampleResult.setResponseData(res.body(), 'UTF-8')
if (!(res.statusCode() == 200 || res.statusCode() == 202)) {
  SampleResult.setSuccessful(false)
  String msg = 'UNEXPECTED_BID_HTTP_' + res.statusCode()
  try {
    def err = new groovy.json.JsonSlurper().parseText(res.body())
    msg += '_' + ((err.code ?: '') as String) + '_' + ((err.message ?: '') as String).replaceAll('[^A-Za-z0-9_.-]+', '_')
  } catch (Throwable ignored) {}
  SampleResult.setResponseMessage(msg.take(500))
  return
}
if (res.statusCode() == 200) {
  def json = new groovy.json.JsonSlurper().parseText(res.body())
  if ((json.decision_status ?: '').toString() != 'DECIDED') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('NOT_DECIDED')
    return
  }
  if ((json.durability_status ?: '').toString() != 'ENGINE_DURABLE') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('NOT_ENGINE_DURABLE')
    return
  }
}
SampleResult.setSuccessful(true)
SampleResult.setResponseMessage('BID_DECIDED_DURABLE_' + id)
          ]]></stringProp>
        </JSR223Sampler>
