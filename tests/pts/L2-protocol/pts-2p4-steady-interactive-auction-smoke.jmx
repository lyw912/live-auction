      <stringProp name="TestPlan.comments">L2-P4 smoke: harness-only 1 minute PTS validation. Uses a 3 bidder / 3 WebSocket viewer / 1 reader ratio under PTS max VU 7, one bid per bidder after WebSockets connect, short fanout observation, and one pressure IP. Intended only to prove that bid and fanout samplers complete and that PTS reports their p99; not capacity evidence.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
