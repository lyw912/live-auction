        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="read pacing jitter" enabled="true">
          <stringProp name="ConstantTimer.delay">${__P(read_delay_ms,1000)}</stringProp>
