        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="WS upgrade to first message" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">l2-ws-upgrade-first-message-v2</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.URI
import java.net.http.HttpClient
import java.net.http.WebSocket
import java.nio.ByteBuffer
import java.util.concurrent.CountDownLatch
import java.util.concurrent.CompletionStage
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentSkipListSet
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicLong

String protocol = props.getProperty('protocol', 'http')
String wsProtocol = protocol == 'https' ? 'wss' : 'ws'
String host = props.getProperty('host', '172.16.179.112')
String port = props.getProperty('port', '18080')
String ticket = vars.get('ws_ticket') ?: ''
if (ticket == '') {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('WS_TICKET_NOT_IN_VARS')
  return
}
def client = HttpClient.newHttpClient()
def firstMessage = new CountDownLatch(1)
def closed = new CountDownLatch(1)
def messages = new AtomicInteger(0)
def maxSeq = new AtomicLong(0)
def maxFanoutLatencyMs = new AtomicLong(0)
def seenSeqs = new ConcurrentSkipListSet<Long>()
def latencyBySeq = new ConcurrentHashMap<Long, Long>()
def listenerErrors = new java.util.concurrent.ConcurrentLinkedQueue<String>()
def maxFn = { long a, long b -> Math.max(a, b) } as java.util.function.LongBinaryOperator
def ws = client.newWebSocketBuilder()
  .header('X-Auction-WS-Ticket', ticket)
  .buildAsync(URI.create(wsProtocol + '://' + host + ':' + port + '/ws?room_id=room_main&auction_id=auc_live&last_seq=0'),
    new WebSocket.Listener() {
      void onOpen(WebSocket webSocket) { webSocket.request(1) }
      java.util.concurrent.CompletionStage<?> onText(WebSocket webSocket, CharSequence data, boolean last) {
        messages.incrementAndGet()
        long receivedAt = System.currentTimeMillis()
        try {
          def event = new groovy.json.JsonSlurper().parseText(data.toString())
          long seq = ((event.seq ?: 0) as Number).longValue()
          if (seq > 0L) {
            seenSeqs.add(seq)
            maxSeq.accumulateAndGet(seq, maxFn)
            if (event.published_at_ms != null) {
              long publishedAt = (event.published_at_ms as Number).longValue()
              long latency = Math.max(0L, receivedAt - publishedAt)
              latencyBySeq.put(seq, latency)
              maxFanoutLatencyMs.accumulateAndGet(latency, maxFn)
            }
          }
        } catch (Throwable t) {
          listenerErrors.add('PARSE_' + t.getClass().getSimpleName())
        }
        firstMessage.countDown()
        webSocket.request(1)
        return null
      }
      CompletionStage<?> onPing(WebSocket webSocket, ByteBuffer data) {
        webSocket.request(1)
        return null
      }
      CompletionStage<?> onPong(WebSocket webSocket, ByteBuffer data) {
        webSocket.request(1)
        return null
      }
      java.util.concurrent.CompletionStage<?> onClose(WebSocket webSocket, int statusCode, String reason) {
        closed.countDown()
        return null
      }
      void onError(WebSocket webSocket, Throwable error) {
        listenerErrors.add('WS_ERROR_' + error.getClass().getSimpleName())
        closed.countDown()
      }
    }).join()
boolean gotFirst = firstMessage.await(Long.parseLong(props.getProperty('ws_first_message_timeout_ms', '5000')), TimeUnit.MILLISECONDS)
vars.putObject('l2_ws', ws)
vars.putObject('l2_ws_closed', closed)
vars.putObject('l2_ws_seen_seqs', seenSeqs)
vars.putObject('l2_ws_latency_by_seq', latencyBySeq)
vars.putObject('l2_ws_max_fanout_latency_ms', maxFanoutLatencyMs)
vars.putObject('l2_ws_listener_errors', listenerErrors)
if (!gotFirst) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('504')
  SampleResult.setResponseMessage('WS_FIRST_MESSAGE_TIMEOUT')
  return
}
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('WS_FIRST_MESSAGE_OK_MESSAGES_' + messages.get() + '_MAX_SEQ_' + maxSeq.get())
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="WS fanout receive all seq" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">l2-ws-fanout-receive-all-seq-v3</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest

def seenSeqs = vars.getObject('l2_ws_seen_seqs') as java.util.concurrent.ConcurrentSkipListSet
def latencyBySeq = vars.getObject('l2_ws_latency_by_seq') as java.util.concurrent.ConcurrentHashMap
def maxFanoutLatencyMs = vars.getObject('l2_ws_max_fanout_latency_ms') as java.util.concurrent.atomic.AtomicLong
def listenerErrors = vars.getObject('l2_ws_listener_errors') as java.util.concurrent.ConcurrentLinkedQueue
if (seenSeqs == null || latencyBySeq == null || maxFanoutLatencyMs == null) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('WS_STATE_MISSING')
  return
}
SampleResult.samplePause()
String protocol = props.getProperty('protocol', 'http')
String host = props.getProperty('host', '172.16.179.112')
String port = props.getProperty('port', '18080')
String base = protocol + '://' + host + ':' + port
def httpClient = HttpClient.newHttpClient()
int minFinalSeq = Integer.parseInt(props.getProperty('fanout_min_final_seq', '1'))
long finalSeqDeadline = System.currentTimeMillis() + Long.parseLong(props.getProperty('fanout_final_seq_timeout_ms', '45000'))
int expectedFinalSeq = 0
while (System.currentTimeMillis() < finalSeqDeadline) {
  def req = HttpRequest.newBuilder(URI.create(base + '/api/auctions/auc_live'))
    .header('Authorization', 'Bearer ' + vars.get('viewer_token'))
    .GET()
    .build()
  def res = httpClient.send(req, java.net.http.HttpResponse.BodyHandlers.ofString())
  if (res.statusCode() != 200) {
    SampleResult.sampleResume()
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(Integer.toString(res.statusCode()))
    SampleResult.setResponseMessage('WS_FINAL_SNAPSHOT_FAILED')
    return
  }
  def snapshot = new groovy.json.JsonSlurper().parseText(res.body())
  expectedFinalSeq = ((snapshot.seq ?: 0) as Number).intValue()
  if (expectedFinalSeq >= minFinalSeq) break
  Thread.sleep(100)
}
if (expectedFinalSeq < minFinalSeq) {
  SampleResult.sampleResume()
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('409')
  SampleResult.setResponseMessage('WS_FINAL_SEQ_TOO_LOW_' + expectedFinalSeq + '_MIN_' + minFinalSeq)
  return
}
long timeoutAt = System.currentTimeMillis() + Long.parseLong(props.getProperty('fanout_receive_timeout_ms', '15000'))
while (System.currentTimeMillis() < timeoutAt) {
  boolean complete = true
  for (int seq = 1; seq <= expectedFinalSeq; seq++) {
    if (!seenSeqs.contains(seq as Long) || !latencyBySeq.containsKey(seq as Long)) {
      complete = false
      break
    }
  }
  if (complete) break
  Thread.sleep(10)
}
def missing = []
def missingLatency = []
for (int seq = 1; seq <= expectedFinalSeq; seq++) {
  if (!seenSeqs.contains(seq as Long)) missing.add(seq)
  if (!latencyBySeq.containsKey(seq as Long)) missingLatency.add(seq)
}
if (!missing.isEmpty() || !missingLatency.isEmpty()) {
  SampleResult.sampleResume()
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('504')
  SampleResult.setResponseMessage('WS_FANOUT_MISSING_SEQ_' + missing.join('|') + '_MISSING_LATENCY_' + missingLatency.join('|'))
  return
}
if (listenerErrors != null && !listenerErrors.isEmpty()) {
  SampleResult.sampleResume()
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('WS_LISTENER_ERRORS_' + listenerErrors.take(3).join('|'))
  return
}
long maxLatency = Math.max(1L, maxFanoutLatencyMs.get())
SampleResult.sampleResume()
Thread.sleep(maxLatency)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('WS_FANOUT_ALL_SEQ_OK_FINAL_' + expectedFinalSeq + '_MAX_LAT_MS_' + maxLatency)
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="WS close" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">l2-ws-close-v1</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.http.WebSocket
import java.util.concurrent.TimeUnit

def ws = vars.getObject('l2_ws')
def closed = vars.getObject('l2_ws_closed') as java.util.concurrent.CountDownLatch
if (ws != null) {
  try { ws.sendClose(WebSocket.NORMAL_CLOSURE, 'done').join() } catch (Throwable ignored) {}
}
if (closed != null) closed.await(1000, TimeUnit.MILLISECONDS)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('WS_CLOSED')
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="20 read traffic" enabled="true">
