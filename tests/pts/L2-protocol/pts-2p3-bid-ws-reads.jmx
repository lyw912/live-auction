<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="L2-P3 bid plus WebSocket plus reads" enabled="true">
      <stringProp name="TestPlan.comments">L2-P3: mixed single-room protocol pressure: 1008 one-shot hot bids plus 4998 WebSocket viewers plus 994 paced HTTP reader VUs. These counts are exact multiples for 14 Alibaba PTS pressure IPs while preserving the business shape of about 1000 bidders, 5000 viewers, and 1000 readers. WS is split into join snapshot, ticket, upgrade-to-first-message, fanout receipt, and close samplers. The fanout sampler reports each connection's worst published_at_ms-to-client-receive latency for all expected public seqs, so PTS can display a real client fanout p99 instead of long-connection dwell time.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
