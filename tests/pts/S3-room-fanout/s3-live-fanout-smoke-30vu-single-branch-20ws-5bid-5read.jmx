        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 mixed VU start barrier" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">s3-mixed-vu-start-barrier-v1</stringProp>
          <stringProp name="script"><![CDATA[
long wait = Long.parseLong(props.getProperty('s3_start_barrier_wait_ms', '15000'))
long quantum = Long.parseLong(props.getProperty('s3_start_barrier_quantum_ms', '1000'))
def target = props.get('s3_start_barrier_target_ms') as java.util.concurrent.atomic.AtomicLong
if (target == null) {
  long desired = System.currentTimeMillis() + wait
  long aligned = ((desired + quantum - 1L) / quantum) * quantum
  target = new java.util.concurrent.atomic.AtomicLong(aligned)
  def existing = props.putIfAbsent('s3_start_barrier_target_ms', target)
  if (existing != null) target = existing as java.util.concurrent.atomic.AtomicLong
}
long sleep = target.get() - System.currentTimeMillis()
if (sleep > 0L) Thread.sleep(sleep)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('S3_MIXED_START_BARRIER_OK_ROLE_' + (vars.get('load_role') ?: 'missing'))
          ]]></stringProp>
        </JSR223Sampler>
