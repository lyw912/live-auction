            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="extract ws ticket" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">s3-extract-ws-ticket</stringProp>
              <stringProp name="script">
if (prev.getResponseCode() != '200') {
  prev.setSuccessful(false)
  prev.setResponseMessage('WS_TICKET_FAILED_' + prev.getResponseCode())
  return
}
def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
String ticket = (json.ticket ?: '').toString()
if (ticket == '') {
  prev.setSuccessful(false)
  prev.setResponseMessage('WS_TICKET_MISSING')
  return
}
vars.put('ws_ticket', ticket)
            </stringProp>
            </JSR223PostProcessor>
            <hashTree />
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 WS handshake complete" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">s3-ws-handshake-complete-v6</stringProp>
            <stringProp name="script">
import java.net.URI
import java.net.http.HttpClient
import java.net.http.WebSocket
import java.nio.ByteBuffer
import java.util.concurrent.CountDownLatch
import java.util.concurrent.CompletionStage
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentSkipListSet
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicLong

String protocol = props.getProperty('protocol', 'http')
String wsProtocol = protocol == 'https' ? 'wss' : 'ws'
String host = props.getProperty('host', '172.16.179.112')
String port = props.getProperty('port', '18080')
String ticket = vars.get('ws_ticket') ?: ''
if (ticket == '') {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('WS_TICKET_NOT_IN_VARS')
  return
}
long setupStartMs = System.currentTimeMillis()
def jmeterProps = org.apache.jmeter.util.JMeterUtils.getJMeterProperties()
String clientKey = 's3_ws_shared_http_client_v7'
def client = jmeterProps.get(clientKey)
if (client == null) {
  synchronized (jmeterProps) {
    client = jmeterProps.get(clientKey)
    if (client == null) {
      client = HttpClient.newBuilder()
        .connectTimeout(java.time.Duration.ofSeconds(Long.parseLong(props.getProperty('ws_connect_timeout_sec', '3'))))
        .build()
      jmeterProps.put(clientKey, client)
    }
  }
}
def firstMessage = new CountDownLatch(1)
def closed = new CountDownLatch(1)
def messages = new AtomicInteger(0)
def maxSeq = new AtomicLong(0)
def maxFanoutLatencyMs = new AtomicLong(0)
def liveMessages = new AtomicInteger(0)
def seenSeqs = new ConcurrentSkipListSet&lt;Long&gt;()
def latencyBySeq = new ConcurrentHashMap&lt;Long, Long&gt;()
def liveSeqs = new ConcurrentSkipListSet&lt;Long&gt;()
def liveLatencyBySeq = new ConcurrentHashMap&lt;Long, Long&gt;()
def listenerErrors = new java.util.concurrent.ConcurrentLinkedQueue&lt;String&gt;()
def textBuffer = new StringBuilder()
def maxFn = { long a, long b -&gt; Math.max(a, b) } as java.util.function.LongBinaryOperator
long setupMs = System.currentTimeMillis() - setupStartMs
long connectedAtMs = System.currentTimeMillis()
long handshakeStartMs = System.currentTimeMillis()
def ws = client.newWebSocketBuilder()
  .header('X-Auction-WS-Ticket', ticket)
  .buildAsync(URI.create(wsProtocol + '://' + host + ':' + port + '/ws?room_id=room_main&amp;auction_id=auc_live&amp;last_seq=0'),
    new WebSocket.Listener() {
      void onOpen(WebSocket webSocket) { webSocket.request(1) }
      java.util.concurrent.CompletionStage&lt;?&gt; onText(WebSocket webSocket, CharSequence data, boolean last) {
        String payload
        synchronized (textBuffer) {
          textBuffer.append(data)
          if (!last) {
            webSocket.request(1)
            return null
          }
          payload = textBuffer.toString()
          textBuffer.setLength(0)
        }
        messages.incrementAndGet()
        long receivedAt = System.currentTimeMillis()
        try {
          def event = new groovy.json.JsonSlurper().parseText(payload)
          long seq = ((event.seq ?: 0) as Number).longValue()
          if (seq &gt; 0L) {
            seenSeqs.add(seq)
            maxSeq.accumulateAndGet(seq, maxFn)
            if (event.published_at_ms != null) {
              long publishedAt = (event.published_at_ms as Number).longValue()
              if (publishedAt &gt;= connectedAtMs) {
                long latency = Math.max(0L, receivedAt - publishedAt)
                liveSeqs.add(seq)
                liveLatencyBySeq.put(seq, latency)
                latencyBySeq.put(seq, latency)
                liveMessages.incrementAndGet()
                maxFanoutLatencyMs.accumulateAndGet(latency, maxFn)
              }
            }
          }
        } catch (Throwable t) {
          listenerErrors.add('PARSE_' + t.getClass().getSimpleName() + '_' + payload.take(40))
        }
        firstMessage.countDown()
        webSocket.request(1)
        return null
      }
      CompletionStage&lt;?&gt; onPing(WebSocket webSocket, ByteBuffer data) {
        webSocket.request(1)
        return null
      }
      CompletionStage&lt;?&gt; onPong(WebSocket webSocket, ByteBuffer data) {
        webSocket.request(1)
        return null
      }
      java.util.concurrent.CompletionStage&lt;?&gt; onClose(WebSocket webSocket, int statusCode, String reason) {
        closed.countDown()
        return null
      }
      void onError(WebSocket webSocket, Throwable error) {
        listenerErrors.add('WS_ERROR_' + error.getClass().getSimpleName())
        closed.countDown()
      }
    }).join()
long handshakeMs = System.currentTimeMillis() - handshakeStartMs
vars.putObject('s3_ws_first_message', firstMessage)
vars.putObject('s3_ws', ws)
vars.putObject('s3_ws_closed', closed)
vars.putObject('s3_ws_messages', messages)
vars.putObject('s3_ws_max_seq', maxSeq)
vars.putObject('s3_ws_seen_seqs', seenSeqs)
vars.putObject('s3_ws_latency_by_seq', latencyBySeq)
vars.putObject('s3_ws_live_seqs', liveSeqs)
vars.putObject('s3_ws_live_latency_by_seq', liveLatencyBySeq)
vars.putObject('s3_ws_max_fanout_latency_ms', maxFanoutLatencyMs)
vars.putObject('s3_ws_live_messages', liveMessages)
vars.putObject('s3_ws_listener_errors', listenerErrors)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('S3_WS_HANDSHAKE_OK_SETUP_MS_' + setupMs + '_HANDSHAKE_MS_' + handshakeMs)
          </stringProp>
          </JSR223Sampler>
          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 WS first snapshot/business message" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">s3-ws-first-message-v6</stringProp>
            <stringProp name="script">
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit

def firstMessage = vars.getObject('s3_ws_first_message') as CountDownLatch
def messages = vars.getObject('s3_ws_messages') as java.util.concurrent.atomic.AtomicInteger
def maxSeq = vars.getObject('s3_ws_max_seq') as java.util.concurrent.atomic.AtomicLong
if (firstMessage == null || messages == null || maxSeq == null) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('S3_WS_FIRST_MESSAGE_STATE_MISSING')
  return
}
boolean gotFirst = firstMessage.await(Long.parseLong(props.getProperty('ws_first_message_timeout_ms', '5000')), TimeUnit.MILLISECONDS)
if (!gotFirst) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('504')
  SampleResult.setResponseMessage('WS_FIRST_MESSAGE_TIMEOUT')
  return
}
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('S3_WS_FIRST_MESSAGE_OK_MESSAGES_' + messages.get() + '_MAX_SEQ_' + maxSeq.get())
          </stringProp>
          </JSR223Sampler>
          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 live fanout receive" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">s3-live-fanout-receive-v6-full-wsonly-fixedhold</stringProp>
            <stringProp name="script">
def seenSeqs = vars.getObject('s3_ws_live_seqs') as java.util.concurrent.ConcurrentSkipListSet
def latencyBySeq = vars.getObject('s3_ws_live_latency_by_seq') as java.util.concurrent.ConcurrentHashMap
def maxFanoutLatencyMs = vars.getObject('s3_ws_max_fanout_latency_ms') as java.util.concurrent.atomic.AtomicLong
def liveMessages = vars.getObject('s3_ws_live_messages') as java.util.concurrent.atomic.AtomicInteger
def listenerErrors = vars.getObject('s3_ws_listener_errors') as java.util.concurrent.ConcurrentLinkedQueue
if (seenSeqs == null || latencyBySeq == null || maxFanoutLatencyMs == null) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('S3_WS_STATE_MISSING')
  return
}
SampleResult.samplePause()
int minLiveMessages = 1
long waitMs = Long.parseLong(props.getProperty('s3_live_observe_ms', '30000'))
long finalSeqDeadline = System.currentTimeMillis() + waitMs
while (System.currentTimeMillis() &lt; finalSeqDeadline) {
  Thread.sleep(250)
}
int observedLiveMessages = liveMessages == null ? 0 : liveMessages.get()
if (observedLiveMessages &lt; minLiveMessages) {
  SampleResult.sampleResume()
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('409')
  SampleResult.setResponseMessage('S3_V6_LIVE_MESSAGES_TOO_LOW_' + observedLiveMessages + '_MIN_' + minLiveMessages + '_LIVE_SEQS_' + seenSeqs.size() + '_OBSERVE_MS_' + waitMs)
  return
}
if (listenerErrors != null &amp;&amp; !listenerErrors.isEmpty()) {
  SampleResult.sampleResume()
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode('500')
  SampleResult.setResponseMessage('S3_WS_LISTENER_ERRORS_' + listenerErrors.take(3).join('|'))
  return
}
long maxLatency = Math.max(1L, maxFanoutLatencyMs.get())
SampleResult.sampleResume()
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('S3_V6_LIVE_FANOUT_OK_LIVE_MESSAGES_' + observedLiveMessages + '_LIVE_SEQS_' + seenSeqs.size() + '_FINAL_SEQ_' + seenSeqs.size() + '_MAX_LAT_MS_' + maxLatency + '_OBSERVE_MS_' + waitMs + '_WS_ONLY')
          </stringProp>
          </JSR223Sampler>
          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 WS close" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">s3-ws-close-v1</stringProp>
            <stringProp name="script">
import java.net.http.WebSocket
import java.util.concurrent.TimeUnit

def ws = vars.getObject('s3_ws')
def closed = vars.getObject('s3_ws_closed') as java.util.concurrent.CountDownLatch
if (ws != null) {
  try { ws.sendClose(WebSocket.NORMAL_CLOSURE, 'done').join() } catch (Throwable ignored) {}
}
if (closed != null) closed.await(1000, TimeUnit.MILLISECONDS)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode('200')
SampleResult.setResponseMessage('WS_CLOSED')
          </stringProp>
          </JSR223Sampler>
          <hashTree />
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="S3 reader branch" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get('load_role') == 'reader')}</stringProp>
          <boolProp name="IfController.useExpression">true</boolProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
