{
  "name": "live-auction-workspace",
  "private": true,
  "scripts": {
    "dev:h5": "pnpm --filter mobile-h5 dev --host 0.0.0.0 --port 5276",
    "dev:pc": "pnpm --filter pc-console dev --host 0.0.0.0 --port 5277",
    "build": "pnpm --filter mobile-h5 build && pnpm --filter pc-console build",
    "test:e2e": "node tests/e2e/run-playwright.mjs",
    "test:e2e:h5-live": "node tests/e2e/run-h5-live-backend-smoke.mjs",
    "test:load:p0": "cd backend && go run ./cmd/p0loadsmoke",
    "test:load:p1:validate": "node tests/load/validate-k6-suite.mjs",
    "test:risk:p4": "node tests/risk/run-p4-risk-simulator.mjs",
    "test:risk:p4:validate": "node tests/risk/validate-p4-risk-simulator.mjs",
    "test:chaos:p1:validate": "node tests/chaos/validate-toxiproxy-config.mjs",
    "test:reconcile:p1": "cd backend && go run ./cmd/reconcile --limit 20",
    "test:perf:p1:ui": "node tests/perf/run-ui-performance-trace.mjs",
    "test:perf:p10:ui": "node tests/perf/run-p10-ui-performance-gate.mjs",
    "test:alerts:p1:validate": "node tests/infra/validate-alert-rules.mjs",
    "test:ai:probe": "node tests/ai/probe-relay-capability.mjs",
    "test:frontend:domain": "node tests/frontend/domain-contract-tests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "packageManager": "pnpm@11.2.2"
}
