{
  "name": "live-auction-workspace",
  "private": true,
  "scripts": {
    "dev:h5": "pnpm --filter mobile-h5 dev --host 127.0.0.1 --port 5173",
    "dev:pc": "pnpm --filter pc-console dev --host 127.0.0.1 --port 5174",
    "build": "pnpm --filter mobile-h5 build && pnpm --filter pc-console build",
    "test:e2e": "node tests/e2e/run-playwright.mjs",
    "test:e2e:h5-live": "node tests/e2e/run-h5-live-backend-smoke.mjs",
    "test:load:p0": "cd backend && go run ./cmd/p0loadsmoke",
    "test:load:p1:validate": "node tests/load/validate-k6-suite.mjs",
    "test:chaos:p1:validate": "node tests/chaos/validate-toxiproxy-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "packageManager": "pnpm@11.2.2"
}
